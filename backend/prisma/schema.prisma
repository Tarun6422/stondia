generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  phone                  String?
  password               String
  role                   Role               @default(CUSTOMER)
  isVerified             Boolean            @default(false)
  resetToken             String?
  resetTokenExp          DateTime?
  verificationToken      String?
  verificationTokenExp   DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  address                String?
  avatar                 String?
  company                String?
  designation            String?
  passwordResetAttempts  Int                @default(0)
  passwordResetOtp       String?
  passwordResetOtpExpiry DateTime?
  blogs                  Blog[]
  contacts               Contact[]
  passwordResetLogs      PasswordResetLog[]
  rfqs                   RFQ[]
  testimonials           Testimonial[]

  @@map("users")
}

model PasswordResetLog {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  method    String   @default("otp")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("password_reset_logs")
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  image         String?   // legacy — kept for backward compatibility
  coverImage    String?
  bannerImage   String?
  thumbnailImage String?
  icon          String?
  featured      Boolean   @default(false)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
  structuredImages StructuredImage[] @relation("CategoryImages")

  @@map("categories")
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String
  categoryId      String
  subCategory     String?
  price           Float?
  finish          String?
  size            String?
  thickness       String?
  origin          String?
  images          String[] @default([]) // legacy — kept for backward compatibility
  mainImage       String?
  thumbnailImage  String?
  textureImage    String?
  applicationImages String[] @default([])
  pdf             String?
  featured        Boolean  @default(false)
  stock           String   @default("In Stock")
  tags            String[] @default([])
  productCode     String?
  applications    String?
  packingDetails  String?
  specs           Json?
  /**
   * Rich product metadata (variants, sizes, technical specs, features,
   * project slugs, comparison data, downloads, etc.) stored as JSON.
   * This allows the admin panel to manage all product data without
   * requiring schema changes for each new field.
   */
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  structuredImages StructuredImage[] @relation("ProductImages")

  @@index([categoryId])
  @@index([featured])
  @@index([slug])
  @@index([productCode])
  @@map("products")
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  location    String?
  description String
  gallery     String[] @default([])
  scope       String[] @default([])
  architect   String?
  stoneUsed   String?
  year        String?
  status      String   @default("Completed")
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("projects")
}

model Blog {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  cover     String?
  authorId  String?
  category  String?
  tags      String[] @default([])
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?    @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([published])
  @@map("blogs")
}

model Video {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  thumbnail   String?
  videoUrl    String?
  youtubeUrl  String?
  category    String?
  duration    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("videos")
}

model Download {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String?
  pdf           String
  fileSize      String?
  category      String?
  featured      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  coverImage    String?
  downloadCount Int           @default(0)
  published     Boolean       @default(false)
  logs          DownloadLog[]

  @@index([slug])
  @@index([published])
  @@index([category])
  @@index([downloadCount])
  @@map("downloads")
}

model DownloadLog {
  id            String    @id @default(cuid())
  downloadId    String
  ip            String?
  userAgent     String?
  country       String?
  browser       String?
  device        String?
  referrer      String?
  createdAt     DateTime  @default(now())
  download      Download  @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  @@index([downloadId])
  @@index([createdAt])
  @@index([country])
  @@index([browser])
  @@index([device])
  @@map("download_logs")
}

model CatalogView {
  id            String           @id @default(cuid())
  catalogId     String
  catalog       GeneratedCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  ip            String?
  userAgent     String?
  country       String?
  browser       String?
  device        String?
  referrer      String?
  createdAt     DateTime         @default(now())

  @@index([catalogId])
  @@index([createdAt])
  @@index([country])
  @@index([browser])
  @@index([device])
  @@map("catalog_views")
}

model Testimonial {
  id          String   @id @default(cuid())
  client      String
  designation String?
  company     String?
  review      String
  rating      Int      @default(5)
  photo       String?
  authorId    String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User?    @relation(fields: [authorId], references: [id])

  @@map("testimonials")
}

model RFQ {
  id          String    @id @default(cuid())
  userId      String?
  company     String?
  phone       String?
  email       String
  country     String?
  message     String
  products    String[]  @default([])
  status      String    @default("Pending")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  adminReply  String?
  attachments String[]  @default([])
  repliedAt   DateTime?
  user        User?     @relation(fields: [userId], references: [id])

  @@map("rfqs")
}

model Contact {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  status    String   @default("Unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@map("contacts")
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("subscribers")
}

model Media {
  id            String   @id @default(cuid())
  filename      String
  originalName  String
  mimeType      String
  size          Int
  url           String
  folder        String   @default("uploads")
  folderRef     MediaFolder? @relation(fields: [folderId], references: [id])
  folderId      String?
  alt           String?
  caption       String?
  tags          String[] @default([])
  width         Int?
  height        Int?
  duration      Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([folder])
  @@index([folderId])
  @@index([mimeType])
  @@index([createdAt])
  @@map("media")
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  parentId  String?
  parent    MediaFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderHierarchy")
  media     Media[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("media_folders")
}

model CatalogTemplate {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  description String?
  type       String             // "master" | "category" | "product" | "brochure" | "technical" | "datasheet" | "guide" | "certificate"
  icon       String?
  defaultFields Json?           // default metadata fields for this template type
  catalogs   GeneratedCatalog[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([slug])
  @@index([type])
  @@map("catalog_templates")
}

model QRCode {
  id            String           @id @default(cuid())
  catalogId     String
  catalog       GeneratedCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  url           String           // the URL the QR code points to
  imageUrl      String?          // URL of the generated QR code image
  label         String?
  scanCount     Int              @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([catalogId])
  @@map("qr_codes")
}

model StructuredImage {
  id            String    @id @default(cuid())
  fileName      String
  displayName   String?
  url           String
  imageType     String    // cover | banner | thumbnail | gallery | texture | project | application | catalogue_cover | seo
  productCode   String?   // Product Code for easy lookup and organization
  categoryId    String?
  productId     String?
  projectId     String?
  altText       String?
  sortOrder     Int       @default(0)
  width         Int?
  height        Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category  Category?  @relation("CategoryImages", fields: [categoryId], references: [id], onDelete: Cascade)
  product   Product?   @relation("ProductImages", fields: [productId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([productId])
  @@index([projectId])
  @@index([imageType])
  @@index([productCode])
  @@map("structured_images")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("settings")
}

model GeneratedCatalog {
  id            String           @id @default(cuid())
  type          String           // "master" | "category" | "product"
  title         String
  slug          String           @unique
  description   String?
  pdfUrl        String?
  coverImage    String?
  tags          String[]         @default([])
  categoryId    String?
  productId     String?
  status        String           @default("draft")  // "draft" | "published" | "archived"
  featured      Boolean          @default(false)
  displayOrder  Int              @default(0)
  version       Int              @default(1)
  downloadCount Int              @default(0)
  lastDownloadAt DateTime?
  fileSize      String?
  metadata      Json?
  templateId    String?
  template      CatalogTemplate? @relation(fields: [templateId], references: [id])
  qrCodes       QRCode[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  versions      CatalogVersion[]

  @@index([type])
  @@index([slug])
  @@index([categoryId])
  @@index([productId])
  @@index([status])
  @@index([featured])
  @@index([displayOrder])
  @@index([downloadCount])
  @@map("generated_catalogs")
}

model CatalogVersion {
  id            String         @id @default(cuid())
  catalogId     String
  version       Int
  pdfUrl        String?
  fileSize      String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  catalog       GeneratedCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId])
  @@index([version])
  @@map("catalog_versions")
}

enum Role {
  ADMIN
  DEALER
  ARCHITECT
  CUSTOMER
}
